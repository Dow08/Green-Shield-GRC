# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# --- Node / frontend ---
node_modules/
dist/
.vite/

# --- Données clients (JAMAIS versionnées) ---
# Les missions vivent désormais hors du dépôt (%APPDATA%/GreenShield ou
# ~/.local/share/greenshield, cf. GREENSHIELD_DATA_DIR). Cette règle reste en
# double sécurité pour l'ancien emplacement : les données d'audit client ne
# doivent en aucun cas entrer dans l'historique git. Voir docs/audit-critique-plan.md (F13).
#
# ⚠️ La barre oblique initiale est essentielle : sans elle, `projects/` exclut
# TOUT dossier de ce nom à n'importe quelle profondeur — y compris le paquet
# applicatif `api/modules/projects/`, qui s'est retrouvé absent du dépôt lors
# de la refonte de `projects.py` en paquet (constaté le 01/08/2026 : `main.py`
# importait `modules.projects.router`, introuvable après clonage).
/projects/

# --- Livrables générés ---
rapport_auditcraft_grc.md
*.log

# --- Docker ---
# (rien à ignorer : compose et Dockerfiles sont versionnés)

# --- OS / IDE ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Bases de données locales ---
# La base réelle vit hors du dépôt (%APPDATA%\GreenShield). `api/data/` est un
# artefact créé quand l'application est lancée depuis un autre répertoire de
# travail : jamais versionné, il peut contenir des données de mission.
*.db
api/data/

# --- Secrets locaux ---
.jwt_secret

# --- Scripts de correctif ponctuels ---
# Générés au fil des sessions pour patcher le code en place ; ce ne sont pas
# des livrables et ils divergent du code dès qu'il évolue.
fix_*.py
append_routes.py
rewrite_test.py
out.txt
old_projects.txt

# --- Artefacts d'empaquetage (executable Windows) ---
# Produits par PyInstaller et par la copie du frontend compile ; le workflow
# les regenere a chaque build, ils n'ont rien a faire dans l'historique.
api/build/
api/dist/
api/web/
*.spec
